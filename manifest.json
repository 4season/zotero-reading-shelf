{
  "manifest_version": 2,
  "name": "Reading Shelf",
  "version": "1.3.3",
  "description": "A bookshelf and Eisenhower reading planner for Zotero collections, with reading status and PDF progress.",
  "applications": {
    "zotero": {
      "id": "reading-shelf@4season.github.io",
      "strict_min_version": "10.0",
      "strict_max_version": "10.*",
      "update_url": "https://raw.githubusercontent.com/4season/zotero-reading-shelf/main/updates.json"
    }
  },
  "icons": {
    "48": "icons/reading-shelf.svg",
    "96": "icons/reading-shelf.svg"
  }
}
